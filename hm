#!/usr/bin/env bash
set -o pipefail

usage() {
    cat <<'EOF'
Usage: hm [-c|--clean] [-n|--dry-run] [--list] [--notify-test]

Options:
  -c, --clean     strip the #UH# prefix from Server entries
  -n, --dry-run   show what would change and write nothing (also works with --clean)
  --list          print the mirrorlist files hm manages (from pacman.conf) and exit
  --notify-test   send a test desktop notification and exit
  -h, --help      show this help message

Exit status:
  0   all mirror lists were processed
  1   error, or no mirror list could be updated (nothing was changed)
  2   some mirror lists were skipped (left unchanged), the others were updated

Environment:
  HM_NOTIFY=auto|always|never   desktop notifications on errors
                                (default: auto = only when not run in a terminal)
  HM_DENY_ON, HM_DENY_RETRY     set by hm-daemon when its DENY_ON mode is enabled;
                                only used to add a hint to warnings and notifications
EOF
}

CLEAN=0
DRY_RUN=0
NOTIFY_TEST=0
LIST=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        -c|--clean)    CLEAN=1 ;;
        -n|--dry-run)  DRY_RUN=1 ;;
        --list)        LIST=1 ;;
        --notify-test) NOTIFY_TEST=1 ;;
        -h|--help)     usage; exit 0 ;;
        *)
            printf 'hm: unknown option: %s\n' "$1" >&2
            usage >&2
            exit 1
            ;;
    esac
    shift
done

if (( LIST + NOTIFY_TEST > 1 )) || { (( LIST + NOTIFY_TEST == 1 )) && (( CLEAN + DRY_RUN > 0 )); }; then
    printf 'hm: --list and --notify-test cannot be combined with other options\n' >&2
    exit 1
fi

# CachyOS mirror status: the first address (the one "rate-mirrors cachyos" uses by default) is
# used first, chosen for its response time; the dashboard API is only a fallback for when the
# first one cannot be used. Both are expected to serve the same data, and test-hm-api.sh
# compares both their results and their speed.
CACHYOS_API='https://cachyos.org/archlinuxmirrorlist/api/cachyos-mirrors'
CACHYOS_API_FALLBACK='https://dashboard.cachyos.org/api/v1/mirrors'
ARCH_API='https://archlinux.org/mirrors/status/json/'
MARK='#UH#'
STALE_MINUTES=1440      # staging files older than this are leftovers of a killed update
NOTIFY_MODE="${HM_NOTIFY:-auto}"
[[ "$LIST" -eq 1 || "$DRY_RUN" -eq 1 ]] && NOTIFY_MODE=never

# ---------------------------------------------------------------------------
# Temporary files
# ---------------------------------------------------------------------------

declare -a TEMPFILES=()
declare -a TARGETS=()
declare -a CANDIDATES=()

NEW_TEMP_PATH=''

new_temp() {
    NEW_TEMP_PATH=$(mktemp) || return 1
    TEMPFILES+=("$NEW_TEMP_PATH")
}

cleanup_temp() {
    local path
    for path in "${TEMPFILES[@]}"; do
        [[ -n "$path" ]] && rm -f -- "$path"
    done
}

trap cleanup_temp EXIT

# ---------------------------------------------------------------------------
# Notifications (errors only; failures of the notification itself go to stderr)
# ---------------------------------------------------------------------------

want_notify() {
    case "$NOTIFY_MODE" in
        always) return 0 ;;
        never)  return 1 ;;
        *)      [[ ! -t 1 && ! -t 2 ]] ;;
    esac
}

desktop_notify() {
    local title="$1" body="$2" out tool
    local sid k v active uid gid sent=0
    local -A notified=()

    want_notify || return 0

    if ! command -v notify-send >/dev/null 2>&1; then
        printf 'hm: notify-send not found; notification skipped\n' >&2
        return 0
    fi

    if [[ "$EUID" -ne 0 ]]; then
        if ! out=$(timeout 5 notify-send -a hm -u critical \
                -i dialog-warning "$title" "$body" 2>&1); then
            printf 'hm: notification failed: %s\n' "$out" >&2
        fi
        return 0
    fi

    for tool in loginctl setpriv timeout; do
        if ! command -v "$tool" >/dev/null 2>&1; then
            printf 'hm: %s not found; notification skipped\n' "$tool" >&2
            return 0
        fi
    done

    while read -r sid _; do
        [[ -n "$sid" ]] || continue

        active=''
        uid=''

        while IFS='=' read -r k v; do
            case "$k" in
                Active) active="$v" ;;
                User)   uid="$v" ;;
            esac
        done < <(loginctl show-session "$sid" -p Active -p User 2>/dev/null)

        [[ "$active" == yes && "$uid" =~ ^[0-9]+$ && "$uid" -ne 0 ]] || continue
        [[ -z "${notified[$uid]:-}" ]] || continue
        notified[$uid]=1

        gid=$(id -g "$uid" 2>/dev/null) || {
            printf 'hm: cannot resolve gid of uid %s\n' "$uid" >&2
            continue
        }

        # /run/user/$uid is mode 0700: do not test for the bus socket as root
        # (the daemon's sandbox has no CAP_DAC_OVERRIDE); just try and report.
        if out=$(timeout 5 setpriv --reuid="$uid" --regid="$gid" \
                --clear-groups \
                env DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
                    XDG_RUNTIME_DIR="/run/user/$uid" \
                notify-send -a hm -u critical -i dialog-warning \
                    "$title" "$body" 2>&1); then
            sent=$((sent + 1))
            printf 'hm: notified uid %s\n' "$uid" >&2
        else
            printf 'hm: notification to uid %s failed: %s\n' "$uid" "$out" >&2
        fi
    done < <(loginctl list-sessions --no-legend 2>/dev/null)

    [[ "$sent" -gt 0 ]] ||
        printf 'hm: no active user session reached; notification not delivered\n' >&2

    return 0
}

# Hint for the user when hm-daemon blocks the programs that wait for this run (its DENY_ON
# mode). hm-daemon passes HM_DENY_ON (failure|partial) and HM_DENY_RETRY (its cooldown in
# seconds); outside of the daemon both are unset and nothing is printed.
# $1 = severity of this run's outcome: failure (exit 1) | partial (exit 2). A partial result
# blocks only in DENY_ON=partial; a failure blocks in both modes.
deny_hint() {
    local retry="${HM_DENY_RETRY:-}"

    case "${HM_DENY_ON:-}:$1" in
        failure:failure|partial:failure|partial:partial) ;;
        *) return 0 ;;
    esac

    if [[ "$retry" =~ ^[0-9]+([.][0-9]+)?$ ]] &&
       awk -v r="$retry" 'BEGIN { exit !(r > 0) }'; then
        printf 'Programs waiting for this check were blocked (DENY_ON=%s). Starting the program again within %s s lets it continue with the existing mirror lists.' \
            "$HM_DENY_ON" "$retry"
    else
        printf 'Programs waiting for this check were blocked (DENY_ON=%s) and stay blocked until a check succeeds.' \
            "$HM_DENY_ON"
    fi
}

die() {
    local hint

    printf 'hm: %s\n' "$*" >&2
    hint=$(deny_hint failure)
    [[ -z "$hint" ]] || printf 'hm: %s\n' "$hint" >&2
    desktop_notify 'hm: mirror check failed' "$*${hint:+ $hint}"
    exit 1
}

if [[ "$NOTIFY_TEST" -eq 1 ]]; then
    NOTIFY_MODE=always
    desktop_notify 'hm: test notification' \
        'If you can see this, error notifications work.'
    printf 'Test notification attempted.\n'
    exit 0
fi

# ---------------------------------------------------------------------------
# Privileged operations
# ---------------------------------------------------------------------------

# Use elevated privileges only for operations that write/remove files
# in system-owned mirrorlist directories.
run_priv() {
    if [[ "$EUID" -eq 0 ]]; then
        "$@"
    else
        sudo "$@"
    fi
}

# Invariant: the only difference between a mirrorlist and its candidate may be the
# #UH# marker in front of "Server = " lines. Normalize both files (remove the marker
# from Server lines only, ensure a final newline) and compare them byte-for-byte.
assert_invariant() {
    local original="$1" candidate="$2"
    local original_normalized candidate_normalized

    original_normalized=$(mktemp) || return 1
    candidate_normalized=$(mktemp) || {
        rm -f -- "$original_normalized"
        return 1
    }

    if ! sed -e 's/^#UH#Server = /Server = /' -e '$a\' "$original" > "$original_normalized" ||
       ! sed -e 's/^#UH#Server = /Server = /' -e '$a\' "$candidate" > "$candidate_normalized" ||
       ! cmp -s -- "$original_normalized" "$candidate_normalized"; then
        rm -f -- "$original_normalized" "$candidate_normalized"
        return 1
    fi

    rm -f -- "$original_normalized" "$candidate_normalized"
    return 0
}

# ---------------------------------------------------------------------------
# Deferred termination
#
# A SIGTERM/SIGINT/SIGHUP that arrives while mirrorlists are being replaced
# (e.g. when hm-daemon or the system is stopped) is remembered and acted on
# only after the replacement has finished or been rolled back cleanly.
# ---------------------------------------------------------------------------

TERM_PENDING=0

defer_termination() {
    TERM_PENDING=0
    trap 'TERM_PENDING=1' TERM INT HUP
}

allow_termination() {
    trap - TERM INT HUP
    if [[ "$TERM_PENDING" -eq 1 ]]; then
        printf 'hm: terminated (deferred until the mirrorlist update finished)\n' >&2
        exit 143
    fi
}

# ---------------------------------------------------------------------------
# Read pacman Include directives.
# Expand ordinary shell globs and ignore missing optional files.
# A mirrorlist that is a symlink is an error: updating it would write through the
# link, outside of the transaction (cp -a turns the staging file into a symlink).
# ---------------------------------------------------------------------------

declare -a MIRRORLISTS=()
declare -A SEEN_LISTS=()

while IFS= read -r include; do
    [[ -n "$include" ]] || continue

    # pacman.conf paths are expected to be absolute in this use case.
    if [[ "$include" != /* ]]; then
        printf 'hm: skipping non-absolute Include path: %s\n' "$include" >&2
        continue
    fi

    shopt -s nullglob
    matches=( $include )
    shopt -u nullglob

    for mirrorlist in "${matches[@]}"; do
        if [[ -L "$mirrorlist" ]]; then
            die "$mirrorlist is a symlink (to $(readlink -- "$mirrorlist")); symlinked mirrorlists are not supported because updating one would write through the link, outside of the transaction"
        fi
        [[ -f "$mirrorlist" ]] || continue
        [[ -z "${SEEN_LISTS[$mirrorlist]:-}" ]] || continue

        SEEN_LISTS[$mirrorlist]=1
        MIRRORLISTS+=("$mirrorlist")
    done
done < <(
    awk '
        /^[[:space:]]*#/ { next }
        /^[[:space:]]*Include[[:space:]]*=/ {
            sub(/^[[:space:]]*Include[[:space:]]*=[[:space:]]*/, "")
            sub(/[[:space:]]*#.*/, "")
            sub(/[[:space:]]*$/, "")
            if ($0 != "") print
        }
    ' /etc/pacman.conf
)

if [[ "${#MIRRORLISTS[@]}" -eq 0 ]]; then
    die 'no existing mirrorlist files found in /etc/pacman.conf'
fi

# --list: the single source of truth for which files hm updates (used by install-daemon.sh)
if [[ "$LIST" -eq 1 ]]; then
    printf '%s\n' "${MIRRORLISTS[@]}"
    exit 0
fi

# directories of the managed mirrorlists (where staging files are created)
declare -a MIRRORLIST_DIRS=()
declare -A SEEN_DIRS=()
for mirrorlist in "${MIRRORLISTS[@]}"; do
    dir="${mirrorlist%/*}"
    [[ -n "$dir" ]] || dir=/
    if [[ -z "${SEEN_DIRS[$dir]:-}" ]]; then
        SEEN_DIRS[$dir]=1
        MIRRORLIST_DIRS+=("$dir")
    fi
done

# ---------------------------------------------------------------------------
# Colors
# ---------------------------------------------------------------------------

if [[ -t 1 && "${TERM:-}" != dumb && -z "${NO_COLOR:-}" ]]; then
    GREEN=$'\033[38;5;46m'
    RED=$'\033[38;5;196m'
    RESET=$'\033[0m'
else
    GREEN=''
    RED=''
    RESET=''
fi

WARNING_STYLE="$RED"

# ---------------------------------------------------------------------------
# Stale staging files
#
# Only .hm-stage.* older than STALE_MINUTES: they are copies that were never
# committed. .hm-backup.* files are never removed automatically, because after
# a failed rollback a backup may be the only intact copy.
# ---------------------------------------------------------------------------

stale_stage_files() {
    local dir
    for dir in "${MIRRORLIST_DIRS[@]}"; do
        find "$dir" -maxdepth 1 -type f -name '.hm-stage.*' -mmin +"$STALE_MINUTES" -print 2>/dev/null
    done
}

remove_stale_stage_files() {
    local f removed=0

    while IFS= read -r f; do
        [[ -n "$f" ]] || continue
        run_priv rm -f -- "$f" && removed=$((removed + 1))
    done < <(stale_stage_files)

    if [[ "$removed" -gt 0 ]]; then
        printf 'hm: removed %d stale staging file(s) older than one day\n' "$removed" >&2
    fi
    return 0
}

# ---------------------------------------------------------------------------
# Dry run: describe what would be written
# ---------------------------------------------------------------------------

describe_changes() {   # $1 = current file, $2 = candidate file (same lines, only markers differ)
    awk '
        NR == FNR { cur[FNR] = $0; next }
        cur[FNR] != $0 {
            if (index($0, "#UH#Server = ") == 1)              print "    disable  " substr($0, 14)
            else if (index(cur[FNR], "#UH#Server = ") == 1)   print "    enable   " substr($0, 10)
            else                                              print "    change   " $0
        }
    ' "$1" "$2"
}

declare -a OTHER_SERVERS=()

report_pending() {
    local i f

    printf '==== dry run: nothing is written ====\n'

    if [[ "${#TARGETS[@]}" -eq 0 ]]; then
        printf 'hm: no mirrorlist would change\n'
    else
        for i in "${!TARGETS[@]}"; do
            printf 'hm: would update %s\n' "${TARGETS[$i]}"
            describe_changes "${TARGETS[$i]}" "${CANDIDATES[$i]}"
        done
    fi

    for f in "${OTHER_SERVERS[@]}"; do
        printf 'hm: left as it is (not known to the API): %s\n' "$f"
    done

    while IFS= read -r f; do
        [[ -n "$f" ]] && printf 'hm: would remove stale staging file %s\n' "$f"
    done < <(stale_stage_files)

    return 0
}

# ---------------------------------------------------------------------------
# Transactional replacement
#
# Prepare every staged file and backup before replacing any target.
# Each individual rename is atomic; the set of files is not (see README).
# If a later rename fails, roll back previously committed files. Backups are
# created alongside their targets.
# (Authentication, stale-file cleanup and termination deferral are handled by
# commit_changes.)
# ---------------------------------------------------------------------------

transactional_commit() {
    local count="${#TARGETS[@]}"
    local i target candidate dir stage backup
    local committed=0 rollback_failed=0

    [[ "$count" -eq "${#CANDIDATES[@]}" ]] || {
        printf 'hm: internal error: target/candidate count mismatch\n' >&2
        return 1
    }

    [[ "$count" -gt 0 ]] || return 0

    local -a STAGES=()
    local -a BACKUPS=()
    local -a KEPT=()      # indices of backups that must stay because their restoration failed

    # Prepare every stage and backup before committing anything.
    for i in "${!TARGETS[@]}"; do
        target="${TARGETS[$i]}"
        candidate="${CANDIDATES[$i]}"
        dir="${target%/*}"

        [[ -f "$target" && ! -L "$target" && -f "$candidate" ]] || {
            printf 'hm: target disappeared, is not a regular file or is a symlink: %s\n' "$target" >&2
            rollback_failed=1
            break
        }

        stage=$(run_priv mktemp "$dir/.hm-stage.XXXXXX") || {
            printf 'hm: cannot create staging file for %s\n' "$target" >&2
            rollback_failed=1
            break
        }

        backup=$(run_priv mktemp "$dir/.hm-backup.XXXXXX") || {
            run_priv rm -f -- "$stage"
            printf 'hm: cannot create backup for %s\n' "$target" >&2
            rollback_failed=1
            break
        }

        STAGES+=("$stage")
        BACKUPS+=("$backup")

        # The staging file and the backup must stay regular files: if either became a
        # symlink, writing the candidate would go through it, outside of the transaction.
        run_priv cp -a -- "$target" "$stage" &&
            run_priv cp -a -- "$target" "$backup" &&
            [[ ! -L "$stage" && ! -L "$backup" ]] &&
            run_priv bash -c 'cat -- "$1" > "$2"' _ "$candidate" "$stage" || {
                printf 'hm: cannot prepare replacement for %s\n' "$target" >&2
                rollback_failed=1
                break
            }
    done

    if [[ "$rollback_failed" -ne 0 ]]; then
        for stage in "${STAGES[@]}"; do
            run_priv rm -f -- "$stage" || true
        done
        for backup in "${BACKUPS[@]}"; do
            run_priv rm -f -- "$backup" || true
        done
        return 1
    fi

    # Commit staged files one by one.
    for i in "${!TARGETS[@]}"; do
        target="${TARGETS[$i]}"
        stage="${STAGES[$i]}"

        # Detect changes to the original after staging.
        if ! run_priv cmp -s -- "${BACKUPS[$i]}" "$target"; then
            printf 'hm: target changed during preparation: %s\n' "$target" >&2
            rollback_failed=1
            break
        fi

        if run_priv mv -f -- "$stage" "$target"; then
            committed=$((committed + 1))
        else
            printf 'hm: cannot replace %s\n' "$target" >&2
            rollback_failed=1
            break
        fi
    done

    if [[ "$rollback_failed" -ne 0 ]]; then
        # Restore the files that were already replaced. A successful restoration moves the
        # backup over the target, so that backup no longer exists; a backup whose restoration
        # failed is kept (KEPT) and reported, because it may be the only intact copy.
        for ((i = committed - 1; i >= 0; i--)); do
            target="${TARGETS[$i]}"
            backup="${BACKUPS[$i]}"

            if ! run_priv mv -f -- "$backup" "$target"; then
                printf 'hm: CRITICAL: rollback failed for %s\n' "$target" >&2
                printf 'hm: backup retained at %s\n' "$backup" >&2
                rollback_failed=2
                KEPT[i]=1
            fi
        done

        for i in "${!STAGES[@]}"; do
            run_priv rm -f -- "${STAGES[$i]}" || true
        done

        # Remove every backup except those that could not be restored.
        for i in "${!BACKUPS[@]}"; do
            [[ -z "${KEPT[$i]:-}" ]] || continue
            run_priv rm -f -- "${BACKUPS[$i]}" || true
        done

        if [[ "$rollback_failed" -eq 2 ]]; then
            printf 'hm: manual recovery may be required\n' >&2
        fi
        return 1
    fi

    for backup in "${BACKUPS[@]}"; do
        run_priv rm -f -- "$backup" || {
            printf 'hm: warning: could not remove backup %s\n' "$backup" >&2
        }
    done

    return 0
}

# Authenticate once (may prompt), remove stale staging files, then run the
# replacement with termination deferred, so it always ends in a consistent state.
commit_changes() {
    local rc

    # Nothing to write: only root cleans up on its own, a regular user must not be
    # asked for sudo just for that.
    if [[ "${#TARGETS[@]}" -eq 0 && "$EUID" -ne 0 ]]; then
        return 0
    fi

    if [[ "$EUID" -ne 0 ]]; then
        sudo -v || {
            printf 'hm: sudo authentication failed\n' >&2
            return 1
        }
    fi

    remove_stale_stage_files

    [[ "${#TARGETS[@]}" -gt 0 ]] || return 0

    defer_termination
    transactional_commit
    rc=$?
    allow_termination

    return "$rc"
}

# ---------------------------------------------------------------------------
# Clean mode
# ---------------------------------------------------------------------------

if [[ "$CLEAN" -eq 1 ]]; then
    for mirrorlist in "${MIRRORLISTS[@]}"; do
        new_temp || die 'cannot create temporary file'
        candidate=$NEW_TEMP_PATH

        awk '
            /^#UH#Server = / {
                sub(/^#UH#/, "")
            }
            { print }
        ' "$mirrorlist" > "$candidate" ||
            die "failed to process $mirrorlist"

        assert_invariant "$mirrorlist" "$candidate" ||
            die "invariant check failed for $mirrorlist; no changes committed"

        if ! cmp -s -- "$mirrorlist" "$candidate"; then
            TARGETS+=("$mirrorlist")
            CANDIDATES+=("$candidate")
        fi
    done

    if [[ "$DRY_RUN" -eq 1 ]]; then
        report_pending
    else
        commit_changes || die 'clean operation failed; check the errors above'
    fi

    exit 0
fi

# ---------------------------------------------------------------------------
# API downloads and validation
# Malformed single entries are skipped by the jq filters (and reported); a
# response in which more than half of the entries are malformed is refused.
# ---------------------------------------------------------------------------

new_temp || die 'cannot create temporary file'
JSON_CACHYOS=$NEW_TEMP_PATH
new_temp || die 'cannot create temporary file'
JSON_ARCH=$NEW_TEMP_PATH
new_temp || die 'cannot create temporary file'
TMP=$NEW_TEMP_PATH
new_temp || die 'cannot create temporary file'
TMP_V3=$NEW_TEMP_PATH
new_temp || die 'cannot create temporary file'
TMP_V4=$NEW_TEMP_PATH
new_temp || die 'cannot create temporary file'
ARCH_MIRRORS=$NEW_TEMP_PATH
new_temp || die 'cannot create temporary file'
KNOWN_CACHYOS=$NEW_TEMP_PATH
new_temp || die 'cannot create temporary file'
KNOWN_ARCH=$NEW_TEMP_PATH

# Reason why the last API response could not be used (set by check_entries and
# fetch_cachyos_api, which do not exit on their own so that the caller can decide).
FETCH_ERROR=''

# $1 = API name, $2 = "total usable" entry counts
# Returns 0 if the response is usable (a few malformed entries only produce a warning);
# returns 1 and sets FETCH_ERROR if it is not.
check_entries() {
    local api="$1" total usable malformed

    read -r total usable <<<"$2"
    [[ "$total" =~ ^[0-9]+$ && "$usable" =~ ^[0-9]+$ ]] || {
        FETCH_ERROR="cannot count the entries of the $api API response"
        return 1
    }

    malformed=$((total - usable))

    if (( malformed * 2 > total )); then
        FETCH_ERROR="the $api API response looks broken: $malformed of $total entries are malformed"
        return 1
    fi
    if (( malformed > 0 )); then
        printf 'hm: warning: ignored %d of %d malformed entries in the %s API response\n' \
            "$malformed" "$total" "$api" >&2
    fi

    return 0
}

# Download one CachyOS mirror status API ($1 = URL) into the file $2 and check that the
# response is usable. Returns 0 if it is; returns 1 and sets FETCH_ERROR if it is not.
fetch_cachyos_api() {
    local url="$1" file="$2" out counts

    FETCH_ERROR=''

    if ! out=$(curl --connect-timeout 5 --max-time 10 -fsSL "$url" -o "$file" 2>&1); then
        out=${out//$'\n'/ }
        FETCH_ERROR="download failed${out:+: $out}"
        return 1
    fi

    if ! jq -e '
        (.mirrors | type == "array")
        and ([ .mirrors[]
               | select((.url | type == "string") and (.checks | type == "array"))
             ] | length) > 0
    ' "$file" >/dev/null 2>&1; then
        FETCH_ERROR='invalid or incomplete response'
        return 1
    fi

    if ! counts=$(jq -r '
        [ (.mirrors | length),
          ([ .mirrors[]
             | select((.url | type == "string") and (.checks | type == "array"))
           ] | length) ] | @tsv
    ' "$file" 2>/dev/null); then
        FETCH_ERROR='cannot count the entries of the CachyOS API response'
        return 1
    fi

    check_entries CachyOS "$counts"
}

# CachyOS: the primary API first, the fallback only if the primary cannot be used (download
# failed, not valid mirror data, or more than half of its entries unusable). Both failing is
# an error. Using the fallback is not: it is reported on stderr (hm-daemon logs it to the
# journal) and the run continues with the same data.
if ! fetch_cachyos_api "$CACHYOS_API" "$JSON_CACHYOS"; then
    primary_error=$FETCH_ERROR

    fetch_cachyos_api "$CACHYOS_API_FALLBACK" "$JSON_CACHYOS" ||
        die "cannot get CachyOS mirror status: $CACHYOS_API: $primary_error; $CACHYOS_API_FALLBACK: $FETCH_ERROR"

    printf 'hm: warning: CachyOS API %s is not usable (%s); using the fallback %s\n' \
        "$CACHYOS_API" "$primary_error" "$CACHYOS_API_FALLBACK" >&2
fi

curl --connect-timeout 5 --max-time 10 -fsSL "$ARCH_API" -o "$JSON_ARCH" ||
    die 'cannot download Arch Linux mirror status'

jq -e '
    (.urls | type == "array")
    and ([ .urls[]
           | select((.url | type == "string") and .protocol == "https")
         ] | length) > 0
' "$JSON_ARCH" >/dev/null ||
    die 'invalid or incomplete Arch Linux API response'

counts=$(jq -r '
    [ (.urls | length),
      ([ .urls[]
         | select((.url | type == "string") and (.protocol | type == "string"))
       ] | length) ] | @tsv
' "$JSON_ARCH") || die 'cannot count the entries of the Arch Linux API response'
check_entries 'Arch Linux' "$counts" || die "$FETCH_ERROR"

# Validate URLs without treating data as sed/regex syntax.
validate_urls() {
    local file="$1" url

    while IFS= read -r url || [[ -n "$url" ]]; do
        [[ -n "$url" ]] || continue

        [[ "$url" == https://* ]] || return 1
        [[ "$url" != *[[:space:]]* ]] || return 1
        [[ "$url" != *'|'* && "$url" != *'\'* ]] || return 1
        [[ "$url" != *$'\r'* && "$url" != *$'\n'* ]] || return 1
    done < "$file"

    return 0
}

# ---------------------------------------------------------------------------
# Known mirrors: every mirror the APIs list, healthy or not. A mirror that is
# not known (local cache, own server, company mirror, ...) is never touched.
# ---------------------------------------------------------------------------

jq -r '
    .mirrors[]
    | select(.url | type == "string")
    | .url
    | sub("/+$"; "")
    | select(test("^[^[:cntrl:]]+$"))
' "$JSON_CACHYOS" > "$KNOWN_CACHYOS" ||
    die 'cannot parse CachyOS mirror list'

jq -r '
    .urls[]
    | select(.url | type == "string")
    | .url
    | sub("/+$"; "")
    | select(test("^[^[:cntrl:]]+$"))
' "$JSON_ARCH" > "$KNOWN_ARCH" ||
    die 'cannot parse Arch Linux mirror list'

# ---------------------------------------------------------------------------
# CachyOS health lists
# An empty list is not an error here: it only matters for a mirrorlist that
# uses it (such a list is skipped below, the other lists are still updated).
# ---------------------------------------------------------------------------

for architecture in x86_64 x86_64_v3 x86_64_v4; do
    output="$TMP"
    [[ "$architecture" == x86_64_v3 ]] && output="$TMP_V3"
    [[ "$architecture" == x86_64_v4 ]] && output="$TMP_V4"

    jq -r --arg architecture "$architecture" '
        .mirrors[]
        | select((.url | type == "string") and (.checks | type == "array"))
        | select(.url | startswith("https://"))
        | [ .checks[]
            | select(
                (.path | type == "string")
                and (.path | startswith($architecture + "/"))
            )
            | .status
          ] as $checks
        | select(($checks | length) > 0 and all($checks[]; . == "synced"))
        | .url
        | sub("/+$"; "")
    ' "$JSON_CACHYOS" > "$output" ||
        die "cannot parse CachyOS mirror status ($architecture)"

    validate_urls "$output" ||
        die "invalid CachyOS URL ($architecture)"
done

# ---------------------------------------------------------------------------
# Arch Linux health list
# ---------------------------------------------------------------------------

jq -r '
    .urls[]
    | select(
        (.url | type == "string")
        and .protocol == "https"
        and .active == true
        and .last_sync != null
        and .completion_pct == 1.0
        and (.delay | type == "number")
        and .delay < 3600
    )
    | .url
    | sub("/+$"; "")
' "$JSON_ARCH" > "$ARCH_MIRRORS" ||
    die 'cannot parse Arch Linux mirror status'

validate_urls "$ARCH_MIRRORS" ||
    die 'invalid Arch Linux mirror URL'

# ---------------------------------------------------------------------------
# Build and validate all candidates before touching any mirrorlist.
#
# Every list is judged on its own. A list that cannot be updated safely is left exactly
# as it is (and reported); the other lists are updated as usual:
#   - no active "Server = " line would be left, or
#   - the list has mirrors the API knows, but none of them is healthy (unmanaged mirrors
#     alone are no replacement for them: they cannot be vouched for).
# ---------------------------------------------------------------------------

# True if the Server value ($1) starts with one of the URLs given as the remaining arguments.
matches_any() {
    local server="$1" url
    shift

    for url in "$@"; do
        [[ -n "$url" ]] || continue
        if [[ "$server" == "$url/"* || "$server" == "$url" ]]; then
            return 0
        fi
    done
    return 1
}

SUMMARY=''
SUMMARY_PLAIN=''
first=1
skipped_count=0
declare -a PROBLEMS=()     # "name: reason" for every list that is left unchanged

for mirrorlist in "${MIRRORLISTS[@]}"; do
    name=$(basename "$mirrorlist")
    [[ "$name" == mirrorlist ]] && name=arch
    name="${name%-mirrorlist}"

    if [[ "${mirrorlist,,}" != *cachyos* ]]; then
        healthy="$ARCH_MIRRORS"
        known="$KNOWN_ARCH"
    else
        known="$KNOWN_CACHYOS"
        if [[ "${mirrorlist,,}" == *v4* ]]; then
            healthy="$TMP_V4"
        elif [[ "${mirrorlist,,}" == *v3* ]]; then
            healthy="$TMP_V3"
        else
            healthy="$TMP"
        fi
    fi

    mapfile -t HEALTHY_URLS < "$healthy"
    mapfile -t KNOWN_URLS < "$known"

    new_temp || die 'cannot create temporary file'
    candidate=$NEW_TEMP_PATH
    healthy_hit=0
    disabled_hit=0
    other_count=0

    # Match literal URL prefixes in Bash; API data is never executable syntax.
    # healthy -> active; known but unhealthy -> disabled; not known -> left as it is.
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" == "$MARK"Server\ =\ * ]]; then
            line="${line#"$MARK"}"
        fi

        if [[ "$line" == Server\ =\ * ]]; then
            server="${line#Server = }"

            if matches_any "$server" "${HEALTHY_URLS[@]}"; then
                healthy_hit=$((healthy_hit + 1))
                printf '%s\n' "$line"
            elif matches_any "$server" "${KNOWN_URLS[@]}"; then
                disabled_hit=$((disabled_hit + 1))
                printf '%s%s\n' "$MARK" "$line"
            else
                other_count=$((other_count + 1))
                OTHER_SERVERS+=("$mirrorlist: $server")
                printf '%s\n' "$line"
            fi
        else
            printf '%s\n' "$line"
        fi
    done < "$mirrorlist" > "$candidate" ||
        die "failed to process $mirrorlist"

    active_count=$(grep -c '^Server = ' "$candidate" || true)
    commented_count=$(grep -c "^${MARK}Server = " "$candidate" || true)

    # Decide whether this list can be updated.
    skip_reason=''
    if [[ "$disabled_hit" -gt 0 && "$healthy_hit" -eq 0 ]]; then
        if [[ "$active_count" -eq 0 ]]; then
            skip_reason='none of the mirrors listed by the API is healthy (no active mirror would be left)'
        else
            skip_reason='none of the mirrors listed by the API is healthy (only mirrors unknown to the API would stay active)'
        fi
    elif [[ "$active_count" -eq 0 ]]; then
        skip_reason='no active mirror'
    fi

    skip_note=''
    skip_note_plain=''
    if [[ -n "$skip_reason" ]]; then
        PROBLEMS+=("$name: $skip_reason")
        skipped_count=$((skipped_count + 1))

        # The list stays as it is: report its current state, not the rejected candidate.
        active_count=$(grep -c '^Server = ' "$mirrorlist" || true)
        commented_count=$(grep -c "^${MARK}Server = " "$mirrorlist" || true)
        skip_note=", ${WARNING_STYLE}skipped${RESET}"
        skip_note_plain=', skipped'
    else
        assert_invariant "$mirrorlist" "$candidate" ||
            die "invariant check failed for $mirrorlist; no changes committed"

        if ! cmp -s -- "$mirrorlist" "$candidate"; then
            TARGETS+=("$mirrorlist")
            CANDIDATES+=("$candidate")
        fi
    fi

    other_note=''
    [[ "$other_count" -eq 0 ]] || other_note=", ${other_count} other"

    [[ "$first" -eq 1 ]] || {
        SUMMARY+=' | '
        SUMMARY_PLAIN+=' | '
    }

    SUMMARY+=$(printf '%s (%s%s%s/%s%s%s%s%s)' \
        "$name" "$GREEN" "$active_count" "$RESET" \
        "$RED" "$commented_count" "$RESET" "$other_note" "$skip_note")

    SUMMARY_PLAIN+=$(printf '%s (%s/%s%s%s)' \
        "$name" "$active_count" "$commented_count" "$other_note" "$skip_note_plain")

    first=0
done

print_summary() {
    printf '==== mirror summary (%son%s/%soff%s): %s ====\n' \
        "$GREEN" "$RESET" "$RED" "$RESET" "$SUMMARY"
}

# One warning and one notification for all skipped lists. $1 = all | partial
# When run by hm-daemon with DENY_ON, the warning and the notification also say that the
# waiting programs were blocked and how long they can be started again (deny_hint).
report_skipped() {
    local problems='' problem hint

    for problem in "${PROBLEMS[@]}"; do
        problems+="${problems:+; }$problem"
    done

    if [[ "$1" == all ]]; then
        hint=$(deny_hint failure)
        printf '%sWARNING:%s no mirror list was updated: %s\n' "$WARNING_STYLE" "$RESET" "$problems"
        [[ -z "$hint" ]] || printf 'hm: %s\n' "$hint" >&2
        desktop_notify 'hm: no mirror list updated' \
            "No list was updated: ${problems}. Mirror summary (on/off): ${SUMMARY_PLAIN}.${hint:+ $hint}"
    else
        hint=$(deny_hint partial)
        printf '%sWARNING:%s left unchanged: %s\n' "$WARNING_STYLE" "$RESET" "$problems"
        [[ -z "$hint" ]] || printf 'hm: %s\n' "$hint" >&2
        desktop_notify 'hm: some mirror lists not updated' \
            "Left unchanged: ${problems}. The other lists were updated. Mirror summary (on/off): ${SUMMARY_PLAIN}.${hint:+ $hint}"
    fi
}

# Nothing can be updated: same outcome as a failed run (exit status 1).
if [[ "$skipped_count" -eq "${#MIRRORLISTS[@]}" ]]; then
    print_summary
    report_skipped all
    exit 1
fi

if [[ "$DRY_RUN" -eq 1 ]]; then
    report_pending
else
    commit_changes || die 'mirrorlist update failed; check the errors above'
fi

print_summary

# Some lists were skipped, the others are done: warn and exit with status 2, so that callers
# (the "up" function, hm-daemon) can tell this apart from a complete success (0) and from
# a failure (1). This also applies to --dry-run, so that a preview agrees with a real run.
if [[ "$skipped_count" -gt 0 ]]; then
    report_skipped partial
    exit 2
fi

exit 0
