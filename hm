#!/bin/bash
set -o pipefail

usage() {
    cat <<'EOF'
Usage: hm [-c|--clean]

Options:
  -c, --clean   strip the #UH# prefix from Server entries without removing actual uncommented mirrors
  -h, --help    show this help message
EOF
}

CLEAN=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        -c|--clean)
            CLEAN=1
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
    shift
done

API='https://dashboard.cachyos.org/api/v1/mirrors'
MIRRORLIST='/etc/pacman.d/cachyos-mirrorlist'
MARK='#UH#'

# Remove only the marker prefix from previously flagged mirrors
if [[ "$CLEAN" -eq 1 ]]; then
    sudo sed -i "s/^${MARK}//" "$MIRRORLIST" || exit 1
    exit 0
fi


TMP=$(mktemp)
SED=$(mktemp)
trap 'rm -f "$TMP" "$SED"' EXIT



# Get healthy mirrors
curl -fsSL "$API" |
    jq -r '.mirrors[] | select(.overall_status == "healthy") | .url' |
    sed 's:/$::' > "$TMP" || exit 1

# Remove old markers and mark all mirrors
printf 's/^%s//\n/^Server = /s/^/%s/\n' "$MARK" "$MARK" > "$SED"

# Unmark healthy mirrors
while read -r url; do
    printf 's|^%sServer = %s/|Server = %s/|\n' "$MARK" "$url" "$url"
done < "$TMP" >> "$SED" || exit 1

sudo sed -i -f "$SED" "$MIRRORLIST" || exit 1

# Count commented mirrors (lines still prefixed with MARK)
commented_count=$(sudo grep -c "^${MARK}Server = " "$MIRRORLIST" || true)

# Count active mirrors (uncommented Server lines)
active_count=$(sudo grep -c "^Server = " "$MIRRORLIST" || true)

echo "Mirror list cleaned. Active mirrors: $active_count. Commented mirrors: $commented_count"
