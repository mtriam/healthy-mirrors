#!/bin/bash
set -o pipefail

usage() {
    cat <<'EOF'
Usage: hm [-c|--clean]

Options:
  -c, --clean   strip the #UH# prefix from Server entries without removing actual uncommented mirrors
  -h, --help    show this help message
EOF
}

CLEAN=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        -c|--clean)
            CLEAN=1
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
    shift
done

API='https://dashboard.cachyos.org/api/v1/mirrors'
MIRRORLISTS=(
    /etc/pacman.d/cachyos-mirrorlist
    /etc/pacman.d/cachyos-v3-mirrorlist
    /etc/pacman.d/cachyos-v4-mirrorlist
)
MARK='#UH#'

# Remove only the marker prefix from previously flagged mirrors
if [[ "$CLEAN" -eq 1 ]]; then
    for mirrorlist in "${MIRRORLISTS[@]}"; do
        [[ -f "$mirrorlist" ]] || continue
        sudo sed -i "s/^${MARK}//" "$mirrorlist" || exit 1
    done
    exit 0
fi

TMP=$(mktemp)
SED=$(mktemp)
trap 'rm -f "$TMP" "$SED"' EXIT

# Get healthy mirrors
curl --connect-timeout 5 --max-time 10 -fsSL "$API" |
    jq -r '.mirrors[] | select(.overall_status == "healthy") | .url' |
    sed 's:/$::' > "$TMP" || exit 1

# Remove old markers and mark all mirrors
printf 's/^%s//\n/^Server = /s/^/%s/\n' "$MARK" "$MARK" > "$SED"

# Unmark healthy mirrors
while read -r url; do
    printf 's|^%sServer = %s/|Server = %s/|\n' "$MARK" "$url" "$url"
done < "$TMP" >> "$SED" || exit 1

# Apply to all mirrorlists
for mirrorlist in "${MIRRORLISTS[@]}"; do
    [[ -f "$mirrorlist" ]] || continue
    sudo sed -i -f "$SED" "$mirrorlist" || exit 1
done

# Count commented mirrors (lines still prefixed with MARK)
commented_count=$(sudo grep -c "^${MARK}Server = " "${MIRRORLISTS[0]}" || true)

# Count active mirrors (uncommented Server lines)
active_count=$(sudo grep -c "^Server = " "${MIRRORLISTS[0]}" || true)

echo "+++ Mirror lists cleaned: ${active_count} active, ${commented_count} commented +++"
