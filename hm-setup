#!/usr/bin/env bash
# hm-setup - configure and start (or remove) the hm-daemon systemd service
#
# The service unit itself (hm-daemon.service) is installed by the package or by install.sh.
# This script does the part that depends on the system:
#   - asks "hm --list" which mirrorlists exist and writes the matching sandbox paths
#     into a drop-in (10-hm-paths.conf),
#   - lets you choose the daemon options (hm-config.conf, only values that differ from
#     the built-in defaults),
#   - enables and starts the service, and restores the previous settings if the service
#     does not stay up.
set -eu

REPOSITORY_URL="https://github.com/mtriam/healthy-mirrors"

SELF=$(readlink -f -- "$0")
SVC=hm-daemon.service
DROPIN_DIR=/etc/systemd/system/$SVC.d
PATHS_DROPIN=$DROPIN_DIR/10-hm-paths.conf     # generated: sandbox paths
DROPIN=$DROPIN_DIR/hm-config.conf             # settings; "systemctl edit" files (override.conf) sort after it and win

if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then G=$'\e[32m'; R=$'\e[31m'; Y=$'\e[33m'; C=$'\e[36m'; D=$'\e[2m'; B=$'\e[1m'; N=$'\e[0m'; else G=; R=; Y=; C=; D=; B=; N=; fi
ok()   { printf '%s✔%s %-10s %s\n' "$G" "$N" "$1" "$2"; }
warn() { printf '%s!%s %s\n' "$Y" "$N" "$*" >&2; }
die()  { printf '%s✘%s %s\n' "$R" "$N" "$*" >&2; exit 1; }
usage() {
    echo "Usage: ${SELF##*/} [--defaults|-y] [--refresh] [--remove] [-h]"
    echo "  (no option)  choose the daemon options interactively, then enable and start $SVC"
    echo "  --defaults   no questions: keep the current values (the built-in defaults if never"
    echo "               configured), then enable and start $SVC"
    echo "  --refresh    regenerate the sandbox paths from 'hm --list' and restart the service"
    echo "               if it is running; no questions (used after package updates)"
    echo "  --remove     stop and disable $SVC and remove the generated sandbox drop-in"
    echo "               (your settings in hm-config.conf are kept)"
    echo "Repository: $REPOSITORY_URL"
}

ACTION=setup
INTERACTIVE=auto
case "${1:-}" in
    "")                        ;;
    -y|--defaults)             INTERACTIVE=0 ;;
    --refresh)                 ACTION=refresh ;;
    -r|--remove|--uninstall)   ACTION=remove ;;
    -h|--help)                 usage; exit 0 ;;
    *)                         usage >&2; exit 1 ;;
esac
[[ $# -le 1 ]] || { usage >&2; exit 1; }

# self-elevate
[[ $EUID -eq 0 ]] || exec sudo env NO_COLOR="${NO_COLOR:-}" "$SELF" "$@"

# ----------------------------------------------------------------------------- remove
if [[ $ACTION == remove ]]; then
    systemctl disable --now -q "$SVC" 2>/dev/null || true
    rm -f -- "$PATHS_DROPIN"
    rmdir -- "$DROPIN_DIR" 2>/dev/null || true
    systemctl daemon-reload 2>/dev/null || true
    ok removed "$SVC stopped and disabled, generated sandbox drop-in removed"
    if [[ -d $DROPIN_DIR ]]; then warn "settings left in place for a later setup: $DROPIN_DIR"; fi
    exit 0
fi

# ----------------------------------------------------------------------------- checks
systemctl cat "$SVC" >/dev/null 2>&1 ||
    die "$SVC is not installed (install the package, or run install.sh from the repository)"

# hm and the daemon as the unit sees them (the unit sets HM=..., a drop-in may override it)
HM=/usr/bin/hm
for kv in $(systemctl show -p Environment --value "$SVC" 2>/dev/null); do
    [[ $kv == HM=* ]] && HM=${kv#HM=}
done
DAEMON=$(systemctl show -p ExecStart --value "$SVC" 2>/dev/null | sed -n 's/^{ path=\([^ ;]*\).*/\1/p')
[[ -n $DAEMON && -f $DAEMON ]] || die "cannot find the daemon program of $SVC (ExecStart)"
command -v python3 >/dev/null 2>&1 || die "python3 not found"
python3 -c 'import ast,sys; ast.parse(open(sys.argv[1]).read())' "$DAEMON" 2>/dev/null ||
    die "$DAEMON is not valid Python"

# hm runs as root: it must be a regular file reached through real (non-symlink) path
# components, and it and every parent directory up to / must be owned by root and not
# group/world-writable
[[ -e $HM ]] || die "$HM not found - install hm first"
HM_REAL=$(readlink -f -- "$HM")
[[ $HM_REAL == "$HM" ]] || die "$HM is, or sits behind, a symlink (resolves to $HM_REAL)"
[[ -f $HM && -x $HM ]] || die "$HM is not an executable regular file"
p=$HM
while :; do
    [[ $(stat -c %u -- "$p") == 0 ]] || die "$p is not owned by root"
    perms=$(stat -c %A -- "$p")
    [[ ${perms:5:1} != w && ${perms:8:1} != w ]] || die "$p is group/world-writable ($perms)"
    [[ $p == / ]] && break
    p=$(dirname -- "$p")
done

join_list() {
    local out='' x
    for x in "$@"; do out+="${out:+, }$x"; done
    printf '%s' "$out"
}

# ----------------------------------------------------------------------------- sandbox paths
# hm itself says which mirrorlists it updates (single source of truth). hm replaces files
# by rename, which needs write access to their directories.
LIST_OUT=$("$HM" --list) || die "hm --list failed"
mapfile -t LISTS <<<"$LIST_OUT"
[[ ${#LISTS[@]} -gt 0 && -n ${LISTS[0]} ]] || die "hm reports no mirrorlists"

RW_LIST=()
for f in "${LISTS[@]}"; do
    [[ $f =~ [[:space:]] ]] && die "mirrorlist path contains whitespace (not supported in ReadWritePaths): $f"
    if [[ -L $f ]]; then warn "$f is a symlink; hm cannot update symlinked mirrorlists"; fi
    RW_LIST+=("$(dirname -- "$f")")
done
mapfile -t RW_DIRS < <(printf '%s\n' "${RW_LIST[@]}" | sort -u)
RW=
for d in "${RW_DIRS[@]}"; do
    case $d in
        /|/etc|/usr|/var|/boot|/root|/home|/opt|/srv)
            die "refusing to make $d writable for the service (mirrorlists belong in a dedicated directory)" ;;
    esac
    [[ -d $d ]] || die "mirrorlist directory does not exist: $d"
    RW+="-$d "
done
RW="${RW% }"

# read-only subdirectories inside the writable ones: pacman runs hooks as root and gnupg
# holds the package keyring, so a compromised service must not be able to write there
RO_CAND=()
if command -v pacman-conf >/dev/null 2>&1; then
    while IFS= read -r x; do
        if [[ -n $x && $x != / ]]; then RO_CAND+=("${x%/}"); fi
    done < <({ pacman-conf HookDir; pacman-conf GPGDir; } 2>/dev/null || true)
fi
for d in "${RW_DIRS[@]}"; do RO_CAND+=("$d/hooks" "$d/gnupg"); done

declare -A SEEN_RO=()
RO_DIRS=()
for c in "${RO_CAND[@]}"; do
    [[ -n $c && -d $c && ! -L $c && ! $c =~ [[:space:]] ]] || continue
    [[ -z ${SEEN_RO[$c]:-} ]] || continue
    inside=0
    for r in "${RW_DIRS[@]}"; do
        if [[ $c == "$r" || $r == "$c"/* ]]; then inside=0; break; fi   # would hide a writable directory
        if [[ $c == "$r"/* ]]; then inside=1; fi
    done
    if (( inside )); then SEEN_RO[$c]=1; RO_DIRS+=("$c"); fi
done
RO=
for c in "${RO_DIRS[@]}"; do RO+="-$c "; done
RO="${RO% }"

# ----------------------------------------------------------------------------- options
CFG_ORDER=(DENY_ON COOLDOWN HM_TIMEOUT HELPERS_RE SHELLY_RE WATCH MAX_HELD STOP_GRACE RECHECK)
declare -A CFG_DEF=(
    [DENY_ON]=mirrors-partial
    [COOLDOWN]=60
    [HM_TIMEOUT]=45
    [HELPERS_RE]='yay|paru|pikaur|trizen|octopi'
    [SHELLY_RE]='shelly.*'
    [WATCH]=/etc/pacman.conf
    [MAX_HELD]=256
    [STOP_GRACE]=5
    [RECHECK]=600
)
declare -A CFG_CUR=() CFG_NEW=()

# current values: from the drop-in written by an earlier run, else the defaults
for name in "${CFG_ORDER[@]}"; do
    val=
    if [[ -f $DROPIN ]]; then
        val=$(sed -n "s/^Environment=\"$name=\(.*\)\"\$/\1/p" "$DROPIN" | tail -n1)
        val=${val//%%/%}
    fi
    CFG_CUR[$name]=${val:-${CFG_DEF[$name]}}
done

# what each option does (the allowed values are shown separately, see cfg_allowed)
cfg_describe() {
    case $1 in
        DENY_ON) cat <<'EOF'
  What happens to pacman / yay / shelly when the mirror check does not succeed.
  A blocked program fails at startup with "Operation not permitted". Starting it
  again within COOLDOWN seconds lets it through with the existing mirror lists.
  An unavailable mirror status (API down) only blocks in the strict modes failure
  and partial; the mirrors modes only warn in that case.
EOF
        ;;
        COOLDOWN) cat <<'EOF'
  Seconds after a hm run during which no new run is started (also after a failed
  run). In blocking mode this is the window in which a blocked program can be
  started again with the existing lists. 0 = no cooldown (then a blocked program
  stays blocked until hm succeeds).
EOF
        ;;
        HM_TIMEOUT) cat <<'EOF'
  Seconds before a running hm is killed. The waiting programs are then released
  (or blocked, see DENY_ON). Raise it on a slow connection.
EOF
        ;;
        HELPERS_RE) cat <<'EOF'
  AUR helpers / frontends that trigger hm, when started without options or with a
  sync/upgrade operation. The expression is case-insensitive and must match the
  whole process name.
EOF
        ;;
        SHELLY_RE) cat <<'EOF'
  Programs that ALWAYS trigger hm when they open the watched file (e.g. a program
  that only ever syncs). The expression is case-insensitive and must match the
  whole process name.
EOF
        ;;
        WATCH) cat <<'EOF'
  Files the daemon watches: when a trigger program opens one of them, hm runs first.
EOF
        ;;
        MAX_HELD) cat <<'EOF'
  Maximum number of open() calls held while hm runs; further ones are let through
  (also in blocking mode), so a flood of processes cannot exhaust the daemon.
EOF
        ;;
        STOP_GRACE) cat <<'EOF'
  Seconds a running hm may finish when the service is stopped or restarted. After
  that it is killed. Held programs are always released on a stop, never blocked.
EOF
        ;;
        RECHECK) cat <<'EOF'
  Interval (seconds) of the safety-net check that every watched file is still
  monitored. Replaced files are normally noticed immediately; this only matters for
  watched symlinks.
EOF
        ;;
    esac
}

# one line for the overview table
cfg_short() {
    case $1 in
        DENY_ON)    echo "block programs when the mirror check fails" ;;
        COOLDOWN)   echo "seconds between hm runs; retry window when blocked" ;;
        HM_TIMEOUT) echo "seconds before a running hm is killed" ;;
        HELPERS_RE) echo "AUR helpers that trigger hm (regex)" ;;
        SHELLY_RE)  echo "programs that always trigger hm (regex)" ;;
        WATCH)      echo "files whose opening triggers hm" ;;
        MAX_HELD)   echo "max. open() calls held while hm runs" ;;
        STOP_GRACE) echo "seconds hm may finish when the service stops" ;;
        RECHECK)    echo "safety-net check interval (0 = off)" ;;
    esac
}

cfg_allowed() {
    case $1 in
        DENY_ON)                      echo "off | mirrors | mirrors-partial | failure | partial" ;;
        COOLDOWN|RECHECK|STOP_GRACE)  echo "a number >= 0 (seconds), e.g. 60" ;;
        HM_TIMEOUT)                   echo "a number > 0 (seconds), e.g. 45" ;;
        MAX_HELD)                     echo "an integer >= 1" ;;
        HELPERS_RE|SHELLY_RE)         echo "a regular expression, e.g. yay|paru" ;;
        WATCH)                        echo "absolute paths separated by \":\", no spaces" ;;
    esac
}

# horizontal rule: tbl_line LEFT MID RIGHT width...
tbl_line() {
    local left=$1 mid=$2 right=$3 out seg w
    shift 3
    out=$left
    for w in "$@"; do
        printf -v seg '%*s' $((w + 2)) ''
        out+=${seg// /─}$mid
    done
    out=${out%"$mid"}$right
    printf '  %s%s%s\n' "$D" "$out" "$N"
}

# Draws a table. Every argument is one row, cells separated by tabs (no empty cells);
# the first row is the header. A cell may start with @g: @y: @c: @d: @b: @r: to be
# shown in green, yellow, cyan, dim, bold or red.
tbl() {
    local -a W=() cells=()
    local row i t col rowno=0
    for row in "$@"; do
        IFS=$'\t' read -r -a cells <<<"$row"
        for i in "${!cells[@]}"; do
            t=${cells[$i]}
            if [[ $t =~ ^@[gycdbr]: ]]; then t=${t:3}; fi
            if (( ${#t} > ${W[$i]:-0} )); then W[$i]=${#t}; fi
        done
    done
    tbl_line ┌ ┬ ┐ "${W[@]}"
    for row in "$@"; do
        IFS=$'\t' read -r -a cells <<<"$row"
        printf '  %s│%s' "$D" "$N"
        for i in "${!W[@]}"; do
            t=${cells[$i]:-}
            col=
            if [[ $t =~ ^@([gycdbr]): ]]; then
                case ${BASH_REMATCH[1]} in
                    g) col=$G ;; y) col=$Y ;; c) col=$C ;; d) col=$D ;; b) col=$B ;; r) col=$R ;;
                esac
                t=${t:3}
            fi
            if (( rowno == 0 )); then col=$B; fi
            printf ' %s%-*s%s %s│%s' "$col" "${W[$i]}" "$t" "${col:+$N}" "$D" "$N"
        done
        printf '\n'
        if (( rowno == 0 )); then tbl_line ├ ┼ ┤ "${W[@]}"; fi
        rowno=$((rowno + 1))
    done
    tbl_line └ ┴ ┘ "${W[@]}"
}

# prints a message and fails if the value is not acceptable (the same rules as in hm-daemon)
cfg_validate() {
    local name=$1 v=$2 p
    if [[ -z $v ]]; then echo "must not be empty"; return 1; fi
    if [[ $v == *[[:cntrl:]]* || $v == *'"'* || $v == *'\'* ]]; then
        echo "must not contain control characters, double quotes or backslashes"; return 1
    fi
    case $name in
        DENY_ON)
            case $v in
                off|mirrors|mirrors-partial|failure|partial) ;;
                *) echo "must be one of: off, mirrors, mirrors-partial, failure, partial"; return 1 ;;
            esac ;;
        COOLDOWN|RECHECK|STOP_GRACE)
            [[ $v =~ ^[0-9]+([.][0-9]+)?$ ]] || { echo "must be a number >= 0 (for example 60 or 0.5)"; return 1; } ;;
        HM_TIMEOUT)
            [[ $v =~ ^[0-9]+([.][0-9]+)?$ ]] && awk -v x="$v" 'BEGIN { exit !(x > 0) }' ||
                { echo "must be a number > 0 (for example 30)"; return 1; } ;;
        MAX_HELD)
            [[ $v =~ ^[0-9]+$ ]] && (( 10#$v >= 1 )) || { echo "must be an integer >= 1"; return 1; } ;;
        HELPERS_RE|SHELLY_RE)
            python3 -c 'import re, sys; re.compile(sys.argv[1], re.I)' "$v" 2>/dev/null ||
                { echo "is not a valid regular expression"; return 1; } ;;
        WATCH)
            [[ $v != *[[:space:]]* ]] || { echo "must not contain whitespace"; return 1; }
            local IFS=:
            for p in $v; do
                [[ -z $p ]] && continue
                [[ $p == /* ]] || { echo "paths must be absolute: $p"; return 1; }
            done ;;
    esac
    return 0
}

ask_options() {
    local name cur rows ans prompt msg
    printf '%shm-daemon configuration%s\n' "$B" "$N"
    printf '  Press %sEnter%s to keep the value in [brackets]; type %sdefault%s to restore the built-in\n' "$B" "$N" "$B" "$N"
    printf '  default. Nothing is changed until you confirm at the end (Ctrl-C aborts).\n'
    if [[ -f $DROPIN ]]; then
        printf '  Current values are taken from %s.\n' "$DROPIN"
    else
        printf '  No earlier settings found: the current values are the built-in defaults.\n'
    fi
    echo
    rows=($'Option\tCurrent\tDefault\tWhat it controls')
    for name in "${CFG_ORDER[@]}"; do
        cur=${CFG_CUR[$name]}
        if [[ $cur != "${CFG_DEF[$name]}" ]]; then cur="@y:$cur"; fi
        rows+=("@c:$name"$'\t'"$cur"$'\t'"${CFG_DEF[$name]}"$'\t'"$(cfg_short "$name")")
    done
    tbl "${rows[@]}"
    printf '  %sYellow%s = differs from the built-in default.\n' "$Y" "$N"

    for name in "${CFG_ORDER[@]}"; do
        echo
        printf '%s%s▌ %s%s  %sdefault: %s%s\n' "$C" "$B" "$name" "$N" "$D" "${CFG_DEF[$name]}" "$N"
        cfg_describe "$name"
        if [[ $name == DENY_ON ]]; then
            echo
            tbl $'Value\tEffect when the check does not succeed' \
                $'@g:off\tnever block: programs always continue, even with outdated lists' \
                $'@g:mirrors\tblock only when the API works but no list has a healthy mirror (API outage: warning only)' \
                $'@g:mirrors-partial\t(default) like mirrors, and also block when some list was skipped' \
                $'@y:failure\tblock when the check failed for any reason, including an API outage or a timeout' \
                $'@r:partial\tstrictest: like failure, and also block when some list was skipped'
        else
            printf '  %sAllowed:%s %s\n' "$C" "$N" "$(cfg_allowed "$name")"
        fi
        echo
        while :; do
            prompt=$(printf '  %s%s%s [%s%s%s]: ' "$B" "$name" "$N" "$Y" "${CFG_CUR[$name]}" "$N")
            read -r -p "$prompt" ans || die "input closed; nothing was changed"
            case $ans in
                "")       ans=${CFG_CUR[$name]} ;;
                default)  ans=${CFG_DEF[$name]} ;;
            esac
            if msg=$(cfg_validate "$name" "$ans"); then
                CFG_NEW[$name]=$ans
                break
            fi
            warn "$name $msg"
        done
    done
}

show_summary() {
    local name new chg rows
    echo
    printf '%sSummary%s\n' "$B" "$N"
    rows=($'Option\tNew value\tDefault\tChange')
    for name in "${CFG_ORDER[@]}"; do
        new=${CFG_NEW[$name]}
        if [[ $new != "${CFG_DEF[$name]}" ]]; then new="@y:$new"; fi
        if [[ ${CFG_NEW[$name]} != "${CFG_CUR[$name]}" ]]; then chg='@g:changed'; else chg='@d:unchanged'; fi
        rows+=("@c:$name"$'\t'"$new"$'\t'"${CFG_DEF[$name]}"$'\t'"$chg")
    done
    tbl "${rows[@]}"
    printf '  %sYellow%s = differs from the built-in default, %sgreen%s = changed in this session.\n' "$Y" "$N" "$G" "$N"
}

# ----------------------------------------------------------------------------- decide values
if [[ $ACTION == setup ]]; then
    if [[ $INTERACTIVE == auto ]]; then
        if [[ -t 0 && -t 1 ]]; then INTERACTIVE=1; else
            die "interactive setup needs a terminal; use '${SELF##*/} --defaults' to keep the current values"
        fi
    fi
    if (( INTERACTIVE )); then
        ask_options
    else
        for name in "${CFG_ORDER[@]}"; do CFG_NEW[$name]=${CFG_CUR[$name]}; done
    fi

    changed_defaults=0
    for name in "${CFG_ORDER[@]}"; do
        if [[ ${CFG_NEW[$name]} != "${CFG_DEF[$name]}" ]]; then changed_defaults=$((changed_defaults + 1)); fi
    done

    if (( INTERACTIVE )); then show_summary; fi
    if [[ ${CFG_NEW[DENY_ON]} != off && ${CFG_NEW[COOLDOWN]} =~ ^0+([.]0*)?$ ]]; then
        warn "DENY_ON with COOLDOWN=0: a blocked program has no window to start again with the existing lists"
    fi
    names_re=$(IFS='|'; echo "${CFG_ORDER[*]}")
    for f in "$DROPIN_DIR"/*.conf; do
        [[ -e $f && $f != "$DROPIN" && $f != "$PATHS_DROPIN" ]] || continue
        if grep -qE "^[[:space:]]*Environment=.*\b($names_re)=" "$f"; then
            warn "$f also sets some of these options; the file that sorts last wins"
        fi
    done

    if (( INTERACTIVE )); then
        echo
        read -r -p "Apply these settings, enable and start $SVC? [Y/n] " ans || die "input closed; nothing was changed"
        case ${ans,,} in ""|y|yes) ;; *) echo "Nothing changed."; exit 0 ;; esac
    fi
fi

# ----------------------------------------------------------------------------- apply
# remember the current state for a rollback
BK=$(mktemp -d /run/hm-setup.XXXXXX) || die "cannot create a temporary directory in /run"
trap 'rm -rf -- "$BK"; rm -f -- "$PATHS_DROPIN.new" "$DROPIN.new"' EXIT
HAD_PATHS=0; HAD_CONF=0; WAS_ACTIVE=0; WAS_ENABLED=0
if [[ -f $PATHS_DROPIN ]]; then HAD_PATHS=1; cp -a -- "$PATHS_DROPIN" "$BK/paths"; fi
if [[ -f $DROPIN ]]; then HAD_CONF=1; cp -a -- "$DROPIN" "$BK/conf"; fi
if systemctl is-active --quiet "$SVC"; then WAS_ACTIVE=1; fi
if systemctl is-enabled --quiet "$SVC" 2>/dev/null; then WAS_ENABLED=1; fi

write_paths_dropin() {
    local tmp=$PATHS_DROPIN.new
    {
        echo "# Generated by hm-setup from 'hm --list' (run 'hm-setup --refresh' to regenerate)."
        echo "[Service]"
        echo "ReadWritePaths=$RW"
        if [[ -n $RO ]]; then echo "ReadOnlyPaths=$RO"; fi
    } > "$tmp" || return 1
    chmod 0644 -- "$tmp" || return 1
    mv -f -- "$tmp" "$PATHS_DROPIN" || return 1
}

write_config_dropin() {
    local n tmp=$DROPIN.new
    if (( changed_defaults == 0 )); then
        rm -f -- "$DROPIN"
        return 0
    fi
    {
        echo "# Written by hm-setup (run it again to change the values)."
        echo "# Only options that differ from the built-in defaults are listed."
        echo "[Service]"
        for n in "${CFG_ORDER[@]}"; do
            [[ ${CFG_NEW[$n]} != "${CFG_DEF[$n]}" ]] || continue
            # "%" is a specifier character in unit files
            printf 'Environment="%s=%s"\n' "$n" "${CFG_NEW[$n]//%/%%}"
        done
    } > "$tmp" || return 1
    chmod 0644 -- "$tmp" || return 1
    mv -f -- "$tmp" "$DROPIN" || return 1
}

apply() {
    local restarts
    install -d -o root -g root -m 0755 -- "$DROPIN_DIR" || return 1
    write_paths_dropin || return 1
    if [[ $ACTION == setup ]]; then write_config_dropin || return 1; fi
    systemctl daemon-reload || return 1
    if [[ $ACTION == setup ]]; then systemctl enable -q "$SVC" || return 1; fi
    if [[ $ACTION == setup ]] || (( WAS_ACTIVE )); then
        systemctl restart "$SVC" || return 1
        sleep 2
        restarts=$(systemctl show -p NRestarts --value "$SVC" 2>/dev/null || true)
        if ! systemctl is-active --quiet "$SVC" || [[ ${restarts:-0} != 0 ]]; then
            journalctl -u "$SVC" -n 15 --no-pager >&2 || true
            return 1
        fi
    fi
    return 0
}

restore_file() {   # $1 = file, $2 = backup, $3 = 1 if the file existed before
    if (( $3 )); then
        install -d -o root -g root -m 0755 -- "$DROPIN_DIR" 2>/dev/null || true
        { cp -a -- "$2" "$1.new" && mv -f -- "$1.new" "$1"; } || warn "could not restore $1"
    else
        rm -f -- "$1"
    fi
}

rollback() {
    warn "the service did not start with the new settings; restoring the previous ones"
    restore_file "$PATHS_DROPIN" "$BK/paths" "$HAD_PATHS"
    restore_file "$DROPIN" "$BK/conf" "$HAD_CONF"
    rmdir -- "$DROPIN_DIR" 2>/dev/null || true
    systemctl daemon-reload || true
    if (( ! WAS_ENABLED )); then systemctl disable -q "$SVC" 2>/dev/null || true; fi
    if (( WAS_ACTIVE )); then
        systemctl restart "$SVC" 2>/dev/null || warn "the service did not start with the previous settings either"
    else
        systemctl stop "$SVC" 2>/dev/null || true
    fi
}

if ! apply; then
    rollback
    die "$SVC could not be started and the previous state was restored (see messages above)"
fi

# ----------------------------------------------------------------------------- summary
EXPOSURE=$(systemd-analyze security "$SVC" --no-pager 2>/dev/null | tail -n1 | sed 's/.*: //' || true)
HARDENING="exposure ${EXPOSURE:-n/a}; writable: $(join_list "${RW_DIRS[@]}")"
if (( ${#RO_DIRS[@]} > 0 )); then HARDENING+="; read-only inside: $(join_list "${RO_DIRS[@]}")"; fi

ok hardening "$HARDENING"
if [[ $ACTION == setup ]]; then
    if (( changed_defaults == 0 )); then
        ok configured "all options at their defaults"
    else
        ok configured "$changed_defaults option(s) differ from the defaults ($DROPIN)"
    fi
    ok service "$SVC active, enabled at boot"
elif (( WAS_ACTIVE )); then
    ok service "$SVC restarted"
else
    warn "$SVC is not running; run '${SELF##*/}' to configure and start it"
fi
printf '\n%sLogs:%s    journalctl -fu %s\n%sChange:%s  %s   (options)\n%sRemove:%s  %s --remove\n' \
    "$D" "$N" "$SVC" "$D" "$N" "${SELF##*/}" "$D" "$N" "${SELF##*/}"
