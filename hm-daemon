#!/usr/bin/python3 -u
"""Hold open() of /etc/pacman.conf by pacman/shelly/AUR helpers, run hm, then release.

fanotify permission events are tied to an inode. When a watched file is replaced
(rename or create), the old mark disappears together with the old inode, so an
inotify watch on the parent directory re-marks the new file immediately. A slow
periodic check (RECHECK) is kept as a safety net.

All intervals (cooldown, timeouts, grace period, periodic check) use the monotonic
clock, so changes of the system time cannot shorten or extend them.

By default every held program is allowed to continue when hm is done, whatever the
result. With DENY_ON=failure|partial the daemon answers FAN_DENY instead (the open()
fails with EPERM) to the programs that would trigger hm themselves, when the run ended
with a failure (exit code other than 0 and 2, timeout, hm could not be started) or, with
DENY_ON=partial, also when hm skipped some lists (exit code 2). Other processes that
happen to be held are always allowed. A program started again within the cooldown is
let through (no new hm run, no denial).

Exit status: 0 after a requested stop, 1 for invalid configuration or an
infrastructure error, 2 for an unexpected internal error (the traceback is logged).
Whatever the reason, the kernel allows all outstanding permission requests when the
fanotify descriptor is closed (fanotify(7)), so a dying daemon never leaves programs
blocked; before exiting, the daemon also tries to answer them itself.
"""
import ctypes, errno, math, os, re, select, signal, struct, subprocess, sys, time, traceback

# journald priority prefixes (journald strips them; see "journalctl -p warning")
ERR, WARN = "<3>", "<4>"

# configuration, filled in by load_config()
HM = ""
HM_TIMEOUT = COOLDOWN = RECHECK = STOP_GRACE = 0.0
MAX_HELD = 0
WATCH = []
SHELLY_RE = HELPERS_RE = None
DENY_ON = "off"
DENY_LEVEL = 0

# DENY_ON values: off = never deny; failure = deny when hm failed; partial = also deny when
# hm skipped some lists
DENY_LEVELS = {"off": 0, "failure": 1, "partial": 2}

# exit codes of hm (see hm --help)
HM_PARTIAL = 2

FAN_CLOEXEC, FAN_CLASS_CONTENT = 0x1, 0x4
FAN_OPEN_PERM, FAN_MARK_ADD, FAN_ALLOW, FAN_DENY = 0x10000, 0x1, 1, 2
FANOTIFY_METADATA_VERSION = 3
AT_FDCWD = -100
EVT = struct.Struct("=IBBHQii")   # event_len, vers, reserved, metadata_len, mask, fd, pid
RESP = struct.Struct("=iI")       # fd, response

IN_MOVED_TO, IN_CREATE = 0x80, 0x100
IN_DELETE_SELF, IN_MOVE_SELF = 0x400, 0x800
IN_UNMOUNT, IN_Q_OVERFLOW, IN_IGNORED = 0x2000, 0x4000, 0x8000
IN_ONLYDIR, IN_ISDIR = 0x01000000, 0x40000000
IN_WATCH_MASK = IN_ONLYDIR | IN_CREATE | IN_MOVED_TO | IN_DELETE_SELF | IN_MOVE_SELF
INEVT = struct.Struct("=iIII")    # wd, mask, cookie, name length (name follows, NUL padded)

libc = ctypes.CDLL(None, use_errno=True)
libc.fanotify_init.argtypes = [ctypes.c_uint, ctypes.c_uint]
libc.fanotify_mark.argtypes = [ctypes.c_int, ctypes.c_uint, ctypes.c_uint64,
                               ctypes.c_int, ctypes.c_char_p]
libc.inotify_init1.argtypes = [ctypes.c_int]
libc.inotify_add_watch.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_uint32]
libc.inotify_rm_watch.argtypes = [ctypes.c_int, ctypes.c_int]

STOP = False


class Fatal(Exception):
    """Invalid configuration or unrecoverable infrastructure error: log it and exit with status 1."""


def log(msg, level=""):
    print(f"{level}{msg}", flush=True)


def on_stop(signum, frame):
    global STOP
    STOP = True


# ---------------------------------------------------------------------------
# Configuration (validated once, at startup)
# ---------------------------------------------------------------------------

def env_float(name, default, minimum, exclusive=False):
    raw = os.environ.get(name, default)
    try:
        value = float(raw)
    except ValueError:
        raise Fatal(f"invalid {name}={raw!r}: not a number")
    if not math.isfinite(value) or value < minimum or (exclusive and value == minimum):
        raise Fatal(f"invalid {name}={raw!r}: must be a finite number "
                    f"{'>' if exclusive else '>='} {minimum:g}")
    return value


def env_int(name, default, minimum):
    raw = os.environ.get(name, default)
    try:
        value = int(raw)
    except ValueError:
        raise Fatal(f"invalid {name}={raw!r}: not an integer")
    if value < minimum:
        raise Fatal(f"invalid {name}={raw!r}: must be an integer >= {minimum}")
    return value


def env_regex(name, default):
    raw = os.environ.get(name, default)
    try:
        return re.compile(raw, re.I)
    except re.error as e:
        raise Fatal(f"invalid {name}={raw!r}: {e}")


def env_choice(name, default, choices):
    raw = os.environ.get(name, default)
    value = raw.strip().lower()
    if value not in choices:
        raise Fatal(f"invalid {name}={raw!r}: must be one of {', '.join(choices)}")
    return value


def load_config():
    global HM, HM_TIMEOUT, COOLDOWN, RECHECK, MAX_HELD, STOP_GRACE, WATCH, SHELLY_RE, HELPERS_RE
    global DENY_ON, DENY_LEVEL
    HM = os.environ.get("HM", "/usr/local/bin/hm")
    if not os.path.isabs(HM):
        raise Fatal(f"invalid HM={HM!r}: must be an absolute path")
    HM_TIMEOUT = env_float("HM_TIMEOUT", "30", 0, exclusive=True)   # seconds before hm is killed
    COOLDOWN = env_float("COOLDOWN", "60", 0)                      # min. seconds between hm runs
    RECHECK = env_float("RECHECK", "600", 0)                       # safety-net check interval, 0 = off
    MAX_HELD = env_int("MAX_HELD", "256", 1)                       # max. open() calls held while hm runs
    STOP_GRACE = env_float("STOP_GRACE", "5", 0)                   # seconds a running hm may finish on stop
    WATCH = [os.path.abspath(p) for p in os.environ.get("WATCH", "/etc/pacman.conf").split(":") if p]
    if not WATCH:
        raise Fatal("invalid WATCH: no file given")
    # always trigger (e.g. a program that only ever syncs/downloads)
    SHELLY_RE = env_regex("SHELLY_RE", r"shelly.*")
    # trigger only when run bare/with a package name, or with a sync/upgrade operation
    HELPERS_RE = env_regex("HELPERS_RE", r"yay|paru|pikaur|trizen|octopi")
    # off (default) | failure | partial: when to deny the programs that triggered a hm run
    DENY_ON = env_choice("DENY_ON", "off", DENY_LEVELS)
    DENY_LEVEL = DENY_LEVELS[DENY_ON]


def hm_env():
    """Environment of hm. In deny mode hm is told, so that its warning and its desktop
    notification can say that programs were blocked and for how long a retry gets through."""
    env = os.environ.copy()
    env.pop("HM_DENY_ON", None)
    env.pop("HM_DENY_RETRY", None)
    if DENY_LEVEL:
        env["HM_DENY_ON"] = DENY_ON
        env["HM_DENY_RETRY"] = f"{COOLDOWN:g}"
    return env


def deny_for(rc):
    """True if a hm run that ended with exit code rc must block the programs waiting for it."""
    if rc == 0:
        return False
    if rc == HM_PARTIAL:
        return DENY_LEVEL >= 2
    return DENY_LEVEL >= 1


# ---------------------------------------------------------------------------
# Process helpers
# ---------------------------------------------------------------------------

def ppid_of(pid):
    try:
        with open(f"/proc/{pid}/stat") as f:
            return int(f.read().rsplit(")", 1)[1].split()[1])
    except Exception:
        return 0


def is_descendant(pid, root):
    while pid > 1:
        if pid == root:
            return True
        pid = ppid_of(pid)
    return False


def descendants(root):
    """All live descendants of root, found by walking /proc parent links."""
    children = {}
    try:
        names = os.listdir("/proc")
    except OSError:
        return []
    for name in names:
        if name.isdigit():
            pid = int(name)
            children.setdefault(ppid_of(pid), []).append(pid)
    found, stack = [], [root]
    while stack:
        for child in children.get(stack.pop(), []):
            found.append(child)
            stack.append(child)
    return found


def printable(s):
    """Replace non-printable characters so that process data cannot forge log lines."""
    return "".join(c if c.isprintable() else "?" for c in s)


def proc_comm(pid):
    try:
        with open(f"/proc/{pid}/comm") as f:
            return printable(f.read().strip())
    except Exception:
        return "?"


def proc_args(pid):
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            return [a.decode(errors="replace") for a in f.read().split(b"\0") if a]
    except Exception:
        return []


def is_client(comm):
    """Programs we care about: pacman, AUR helpers, shelly. Only for these the command line
    is read and logged; every other process that opens the file is logged by name only."""
    return comm == "pacman" or bool(HELPERS_RE.fullmatch(comm)) or bool(SHELLY_RE.fullmatch(comm))


# Long names of the pacman options that matter here, mapped to their short form
LONG_TO_SHORT = {"sync": "S", "upgrade": "U", "files": "F", "refresh": "y"}
# Short options that take a value: the rest of a cluster such as "-b/some/path" belongs to the value
SHORT_WITH_VALUE = "br"


def pacman_flags(opts):
    """Letters of the options given, as short options or as exact long names (--sync -> S)."""
    flags = set()
    for a in opts:
        if a.startswith("--"):
            short = LONG_TO_SHORT.get(a[2:].split("=", 1)[0])
            if short:
                flags.add(short)
        else:
            for ch in a[1:]:
                if ch in SHORT_WITH_VALUE:
                    break
                flags.add(ch)
    return flags


def sync_ops(opts):
    """True if the options contain an operation that downloads from mirrors: sync (-S / --sync),
    upgrade (-U / --upgrade) or a file-database refresh (-F with -y / --refresh, in any combination)."""
    flags = pacman_flags(opts)
    return bool(flags & {"S", "U"}) or {"F", "y"} <= flags


def should_trigger(comm, args):
    opts = [a for a in args[1:] if a.startswith("-")]
    if comm == "pacman":
        # only operations that use mirrors: sync, upgrade, file-database refresh (not -Q, -T, -V, ...)
        return sync_ops(opts)
    if HELPERS_RE.fullmatch(comm):
        # no options = interactive search/install by name; otherwise only sync/upgrade
        return not opts or sync_ops(opts)
    return bool(SHELLY_RE.fullmatch(comm))


def deny_candidate(pid):
    """Whether a request that is held while hm runs may be denied if hm fails: only processes
    that would trigger hm themselves (pacman -Syu, yay, shelly, ...). Any other process that
    happens to open the file in the meantime (cat, an editor, pacman -Q) is never denied.
    The process is blocked in open(), so its /proc entry is reliable. Not evaluated (and
    nothing read from /proc) when DENY_ON=off."""
    if not DENY_LEVEL:
        return False
    try:
        comm = proc_comm(pid)
        return should_trigger(comm, proc_args(pid) if is_client(comm) else [])
    except Exception:
        return False                      # a classification error must never lead to a denial


def file_id(path):
    try:
        st = os.stat(path)
        return (st.st_dev, st.st_ino)
    except OSError:
        return None


def add_mark(fan, path):
    """Returns 0 on success, errno on failure."""
    if libc.fanotify_mark(fan, FAN_MARK_ADD, FAN_OPEN_PERM, AT_FDCWD, path.encode()) < 0:
        return ctypes.get_errno()
    return 0


# ---------------------------------------------------------------------------
# Main loop
# ---------------------------------------------------------------------------

def run():
    fan = libc.fanotify_init(FAN_CLOEXEC | FAN_CLASS_CONTENT, os.O_RDONLY | os.O_CLOEXEC)
    if fan < 0:
        raise Fatal(f"fanotify_init: {os.strerror(ctypes.get_errno())}")
    ino = libc.inotify_init1(os.O_NONBLOCK | os.O_CLOEXEC)
    if ino < 0:
        raise Fatal(f"inotify_init1: {os.strerror(ctypes.get_errno())}")

    # signals wake up select() through a pipe; handlers only set a flag
    sig_r, sig_w = os.pipe2(os.O_NONBLOCK | os.O_CLOEXEC)
    signal.set_wakeup_fd(sig_w)
    signal.signal(signal.SIGTERM, on_stop)
    signal.signal(signal.SIGINT, on_stop)

    dirs = sorted({os.path.dirname(p) for p in WATCH})
    wd_dir = {}          # inotify watch descriptor -> directory
    marked = {}          # watched file -> (st_dev, st_ino) it was marked with

    def watch_dir(d):
        wd = libc.inotify_add_watch(ino, d.encode(), IN_WATCH_MASK)
        if wd < 0:
            return ctypes.get_errno()
        wd_dir[wd] = d
        return 0

    def remark(path, always):
        """(Re)apply the fanotify mark. Idempotent; logs only when the inode actually changed."""
        fid = file_id(path)
        if fid is None:
            return                        # gone for now; a later create/move event brings it back
        if not always and fid == marked.get(path):
            return
        err = add_mark(fan, path)
        if err:
            log(f"re-marking {path} failed: {os.strerror(err)}", ERR)
            return
        if fid != marked.get(path):
            log(f"{path} was replaced, re-marked")
        marked[path] = fid

    def resync(reason):
        """Full check: restore lost directory watches, re-mark every file whose inode changed."""
        known = set(wd_dir.values())
        for d in dirs:
            if d not in known:
                err = watch_dir(d)
                if err:
                    log(f"re-adding watch on {d} failed: {os.strerror(err)}", ERR)
                else:
                    log(f"watch on {d} restored ({reason})")
        for p in WATCH:
            remark(p, always=False)

    def handle_inotify():
        try:
            buf = os.read(ino, 65536)
        except BlockingIOError:
            return
        except OSError as e:
            raise Fatal(f"read from inotify failed: {e}")
        off, need_resync = 0, False
        while off + INEVT.size <= len(buf):
            wd, mask, _cookie, ln = INEVT.unpack_from(buf, off)
            name = buf[off + INEVT.size:off + INEVT.size + ln].split(b"\0", 1)[0]
            off += INEVT.size + ln
            if mask & IN_Q_OVERFLOW:
                log("inotify queue overflow, checking all watched files", WARN)
                need_resync = True
                continue
            if mask & IN_MOVE_SELF:                    # directory itself was moved: watch points elsewhere
                libc.inotify_rm_watch(ino, wd)
                wd_dir.pop(wd, None)
                need_resync = True
                continue
            if mask & (IN_IGNORED | IN_UNMOUNT | IN_DELETE_SELF):
                if mask & IN_IGNORED:
                    wd_dir.pop(wd, None)
                need_resync = True
                continue
            d = wd_dir.get(wd)
            if d is None or mask & IN_ISDIR or not mask & (IN_CREATE | IN_MOVED_TO):
                continue
            path = os.path.join(d, os.fsdecode(name))
            if path in marked:
                remark(path, always=True)
        if need_resync:
            resync("inotify")

    # startup order matters: watch first, then mark, so no replacement can slip in between
    for p in WATCH:
        if os.path.islink(p):
            if RECHECK > 0:
                log(f"warning: {p} is a symlink; replacement of its target is only found by the "
                    f"periodic check (every {RECHECK:g} s)", WARN)
            else:
                log(f"warning: {p} is a symlink and the periodic check is disabled (RECHECK=0); "
                    f"replacement of its target will not be detected", WARN)
    for d in dirs:
        err = watch_dir(d)
        if err:
            raise Fatal(f"inotify_add_watch({d}): {os.strerror(err)}")
    for p in WATCH:
        fid = file_id(p)
        err = add_mark(fan, p)
        if err:
            raise Fatal(f"fanotify_mark({p}): {os.strerror(err)}")
        marked[p] = fid
    log(f"watching open() on: {WATCH}")
    if DENY_LEVEL:
        log(f"DENY_ON={DENY_ON}: programs that triggered a hm run are denied (EPERM) when it "
            f"{'failed' if DENY_LEVEL == 1 else 'failed or skipped some lists'}")
        if COOLDOWN == 0:
            log("warning: DENY_ON is set with COOLDOWN=0: a denied program cannot be started again "
                "with the existing mirror lists, it stays blocked until hm succeeds", WARN)

    # held: [(event fd, pid, deny candidate)] of the requests that wait for the running hm
    held, hm = [], None
    t0 = 0.0
    last = -math.inf                      # no hm run yet: the cooldown is not active
    limit_logged = False
    stopping, stop_deadline = False, 0.0
    next_check = time.monotonic() + RECHECK if RECHECK > 0 else None
    me = os.getpid()

    def answer(fd, deny=False):
        """Answer FAN_ALLOW (FAN_DENY if deny) and close the event fd."""
        try:
            os.write(fan, RESP.pack(fd, FAN_DENY if deny else FAN_ALLOW))
        except OSError as e:
            if e.errno == errno.ENOENT:           # requester already gone (killed): harmless
                log(f"event fd={fd} is gone (requesting process ended)")
            else:
                raise Fatal(f"fanotify response failed: {e}")
        finally:
            os.close(fd)

    def retry_note():
        if COOLDOWN > 0:
            return (f"starting the program again within {COOLDOWN:g} s lets it continue "
                    f"with the existing mirror lists")
        return "COOLDOWN=0: it stays blocked until hm succeeds"

    def release(reason, deny=False):
        """Answer every held request, one by one (a failure leaves the rest in `held`).
        With deny, the requests of the processes that triggered hm are denied; the others
        are allowed."""
        nonlocal hm, last
        n = len(held)
        log(f"releasing {n} held open() calls ({reason})")
        hm, last = None, time.monotonic()
        if deny:
            victims = [e for e in held if e[2]]
            if victims:
                pids = ", ".join(str(e[1]) for e in victims[:10]) + (", ..." if len(victims) > 10 else "")
                log(f"denying {len(victims)} of {n} held open() calls (DENY_ON={DENY_ON}, pid {pids}): "
                    f"they fail with EPERM; {retry_note()}", WARN)
        while held:
            fd, _pid, candidate = held.pop(0)
            answer(fd, deny=deny and candidate)

    def abandon_held(reason):
        """Best effort before exiting after an error; the kernel allows whatever is left on exit."""
        if held:
            log(f"{reason}: answering {len(held)} held open() calls before exit", WARN)
        while held:
            fd = held.pop(0)[0]
            try:
                os.write(fan, RESP.pack(fd, FAN_ALLOW))
            except OSError:
                pass
            try:
                os.close(fd)
            except OSError:
                pass

    def stop_hm(reason, level=ERR, deny=False):
        """Kill hm and everything below it (also children that left hm's process group), then release."""
        log(f"{reason}; killing hm", level)
        pids = descendants(hm.pid)                # collect first: after the kill, orphans lose their ancestry
        try:
            os.killpg(hm.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        for p in pids:
            try:
                os.kill(p, signal.SIGKILL)
            except (ProcessLookupError, PermissionError):
                pass
        try:
            hm.wait(timeout=5)
        except subprocess.TimeoutExpired:
            log(f"hm (pid {hm.pid}) did not exit after SIGKILL", ERR)
        release(reason, deny)

    try:
        while True:
            if STOP and not stopping:
                stopping = True
                stop_deadline = time.monotonic() + STOP_GRACE
                log("stop requested" + (f", letting hm finish (up to {STOP_GRACE:g} s)" if hm else ""))
            if stopping and (hm is None or time.monotonic() > stop_deadline):
                if hm is not None:
                    # shutting down is not a failure of hm: never deny here
                    stop_hm("hm did not finish within the stop grace period", WARN)
                break

            if hm:
                timeout = 0.2
            elif next_check is not None:
                timeout = max(0.0, next_check - time.monotonic())
            else:
                timeout = None
            r, _, _ = select.select([fan, ino, sig_r], [], [], timeout)

            if sig_r in r:
                try:
                    os.read(sig_r, 4096)
                except BlockingIOError:
                    pass
            if ino in r:                                # before fanotify: re-mark as early as possible
                handle_inotify()
            if fan in r:
                try:
                    buf = os.read(fan, 65536)
                except OSError as e:
                    raise Fatal(f"read from fanotify failed: {e}")
                off = 0
                while off + EVT.size <= len(buf):
                    ln, vers, _, _, mask, fd, pid = EVT.unpack_from(buf, off)
                    if vers != FANOTIFY_METADATA_VERSION:
                        raise Fatal(f"unsupported fanotify metadata version: {vers}")
                    if ln < EVT.size:
                        break
                    off += ln
                    if fd < 0:
                        continue
                    if pid == me or (hm and is_descendant(pid, hm.pid)):
                        answer(fd)                       # own process / hm descendant: never block
                    elif stopping:
                        answer(fd)                       # shutting down: do not hold anything new
                    elif hm:
                        if len(held) >= MAX_HELD:
                            if not limit_logged:
                                log(f"hold limit ({MAX_HELD}) reached, letting further opens through "
                                    f"(they may proceed with the previous mirror lists)", WARN)
                                limit_logged = True
                            answer(fd)
                        else:
                            # hm running: hold further openers
                            held.append((fd, pid, deny_candidate(pid)))
                    else:
                        try:
                            comm = proc_comm(pid)
                            client = is_client(comm)
                            args = proc_args(pid) if client else []    # other processes: name only
                            ok = should_trigger(comm, args)
                        except Exception as e:           # a bug in classification must not take the daemon down
                            log(f"cannot classify pid={pid}: {e!r}; letting it through", WARN)
                            comm, args, client, ok = "?", [], False, False
                        cool = time.monotonic() - last < COOLDOWN
                        cmd = f" cmd={' '.join(args)[:100]!r}" if client else ""
                        log(f"open pid={pid} comm={comm}{cmd} trigger={ok} cooldown={cool}")
                        if ok and not cool:
                            try:
                                hm = subprocess.Popen([HM], stdin=subprocess.DEVNULL,
                                                      start_new_session=True, env=hm_env())
                            except OSError as e:
                                log(f"cannot start {HM}: {e}", ERR)
                                last = time.monotonic()  # do not retry on every open
                                if DENY_LEVEL >= 1:
                                    log(f"denying pid {pid} (DENY_ON={DENY_ON}): it fails with EPERM; "
                                        f"{retry_note()}", WARN)
                                answer(fd, deny=DENY_LEVEL >= 1)
                            else:
                                t0 = time.monotonic()
                                limit_logged = False
                                held.append((fd, pid, True))
                                log(f"started {HM} (pid {hm.pid})")
                        else:
                            answer(fd)

            if hm:
                rc = hm.poll()
                if rc is not None:
                    deny = deny_for(rc)
                    if rc == 0:
                        log("hm finished OK")
                    elif rc == HM_PARTIAL:
                        log(f"hm skipped some mirror lists (exit code {rc}); "
                            + ("blocking the programs that triggered it"
                               if deny else "held programs continue (the other lists were updated)"),
                            WARN)
                    else:
                        log(f"hm FAILED (exit code {rc}); "
                            + ("blocking the programs that triggered it"
                               if deny else "held programs continue with the existing mirror lists"),
                            ERR)
                    release(f"hm exited with code {rc}", deny)
                elif time.monotonic() - t0 > HM_TIMEOUT:
                    stop_hm(f"hm timed out after {HM_TIMEOUT:g} s", deny=DENY_LEVEL >= 1)
            elif next_check is not None and time.monotonic() >= next_check:
                resync("periodic")
                next_check = time.monotonic() + RECHECK

        if held:
            release("shutdown")
        log("stopped")
    except Fatal:
        abandon_held("fatal error")
        raise
    except Exception:
        abandon_held("unexpected error")
        raise


def main():
    try:
        load_config()
        run()
    except Fatal as e:
        log(f"fatal: {e}", ERR)
        sys.exit(1)
    except Exception:
        log("fatal: unexpected internal error (traceback follows)", ERR)
        traceback.print_exc()
        sys.stderr.flush()
        sys.exit(2)


if __name__ == "__main__":
    main()
